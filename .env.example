# REQ-SE-003: copy to .env and fill in values. Never commit .env.
# docker compose reads this file automatically; the app reads the same names as environment variables.

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shop
DB_USERNAME=shop
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka (host-side listener)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092

# kafka-ui host port (container listens on 8080)
KAFKA_UI_PORT=8089

# Optional (REQ-F-010 4): payment deadline per order, default 15m. 1m demonstrates the automatic cancellation quickly.
# SHOP_PAYMENT_TIMEOUT=1m
